# OpenAI-compatible model provider
LLM_API_KEY=replace-with-your-api-key
LLM_BASE_URL=https://api.example.com/v1
LLM_MODEL=your-model-name
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=60

# Optional image understanding
# off      = ignore image content
# direct   = send images to the main model (the model must support vision)
# separate = describe images with a second vision model, then use that text
VISION_MODE=off
# VISION_API_KEY and VISION_BASE_URL may be omitted to reuse LLM_* values.
VISION_API_KEY=
VISION_BASE_URL=
VISION_MODEL=
VISION_MAX_TOKENS=512
VISION_TIMEOUT_SECONDS=30

# NapCat HTTP Server: bridge -> NapCat actions
NAPCAT_API_URL=http://127.0.0.1:3000
NAPCAT_ACCESS_TOKEN=replace-with-napcat-http-server-token
# Optional Windows control-panel launcher paths. Leave empty if NapCat is started separately.
NAPCAT_BOOT=
NAPCAT_QQ=
NAPCAT_HOOK=

# NapCat HTTP Client: NapCat events -> bridge
NAPCAT_EVENT_TOKEN=replace-with-napcat-http-client-token

# Local bridge <-> bot service authentication
BOT_SERVICE_TOKEN=replace-with-local-service-token

# Local service addresses
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8766
BOT_SERVICE_HOST=127.0.0.1
BOT_SERVICE_PORT=8765
BOT_QQ=
BOT_NAMES=bot

# Reply policy
GROUP_MODE=mention
# heuristic uses local rules; model asks the LLM to choose reply/quote/reaction/ignore in smart groups.
DECISION_MODE=heuristic
GROUP_ALLOWLIST=
DEBOUNCE_SECONDS=random
FOLLOWUP_SECONDS=120
TYPING_STATUS=true
CONTEXT_MESSAGES=20
PERSONA_FILE=./.local/persona_prompt.txt
# Empty by default. Set a path to keep recent normalized context across restarts.
MEMORY_DB=

# Optional cross-machine Supabase memory. Run the migration in
# supabase/migrations/ before enabling these values.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_TIMEOUT_SECONDS=10
REMOTE_MEMORY_MODE=local_first
SUMMARY_ENABLED=false
SUMMARY_MIN_MESSAGES=40
SUMMARY_DELAY_SECONDS=10

# Optional reactions, scheduled messages, and allowlisted tools
REACTION_MODE=off
ACTIVE_ENABLED=false
ACTIVE_INTERVAL_MINUTES=60
ACTIVE_TARGET_TYPE=private
ACTIVE_TARGET_ID=
ACTIVE_PROMPT=
TOOLS_ENABLED=false
TOOL_ALLOWLIST=get_time
