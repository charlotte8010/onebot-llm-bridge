# OpenAI-compatible model provider
LLM_API_KEY=replace-with-your-api-key
LLM_BASE_URL=https://api.example.com/v1
LLM_MODEL=your-model-name
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=60

# NapCat HTTP Server: bridge -> NapCat actions
NAPCAT_API_URL=http://127.0.0.1:3000
NAPCAT_ACCESS_TOKEN=replace-with-napcat-http-server-token

# NapCat HTTP Client: NapCat events -> bridge
NAPCAT_EVENT_TOKEN=replace-with-napcat-http-client-token

# Local bridge <-> bot service authentication
BOT_SERVICE_TOKEN=replace-with-local-service-token

# Local service addresses
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8766
BOT_SERVICE_HOST=127.0.0.1
BOT_SERVICE_PORT=8765
BOT_QQ=
BOT_NAMES=bot

# Reply policy
GROUP_MODE=mention
GROUP_ALLOWLIST=
DEBOUNCE_SECONDS=random
FOLLOWUP_SECONDS=120
TYPING_STATUS=true
CONTEXT_MESSAGES=20
PERSONA_FILE=./.local/persona_prompt.txt
