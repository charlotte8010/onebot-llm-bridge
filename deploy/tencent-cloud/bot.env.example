# Copy this file to /etc/onebot-llm-bridge/bot.env on the cloud server.
# Never commit the filled-in copy.
LLM_API_KEY=replace-with-your-api-key
LLM_BASE_URL=https://api.example.com/v1
LLM_MODEL=your-model-name
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=60

# The cloud Bot process binds here. Local Bridge should use the cloud's
# Tailscale/ZeroTier address, not 0.0.0.0.
BOT_SERVICE_HOST=0.0.0.0
BOT_SERVICE_PORT=8765
BOT_SERVICE_TOKEN=replace-with-a-long-random-token

PERSONA_FILE=/opt/onebot-llm-bridge/.local/persona_prompt.txt
MEMORY_DB=/opt/onebot-llm-bridge/.local/context.sqlite3
CONTEXT_MESSAGES=20
VISION_MODE=off
GROUP_MODE=mention
DECISION_MODE=heuristic
DEBOUNCE_SECONDS=random
TYPING_STATUS=true
REACTION_MODE=off
ACTIVE_PRIVATE_ENABLED=false
ACTIVE_GROUP_ENABLED=false
TOOLS_ENABLED=false
